{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "outline": {
          "listen": [
            "127.0.0.1:8443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "listener_wrappers": [
            {
              "wrapper": "outline_packet_tls"
            },
            {
              "wrapper": "tls"
            }
          ],
          "tls_connection_policies": [
            {}
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "outline.example.com"
                  ],
                  "path": [
                    "/change-me-random-stream-path"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "websocket2layer4",
                  "type": "stream",
                  "connection_handler": "outline-shadowsocks"
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "outline.example.com"
                  ],
                  "path": [
                    "/change-me-random-packet-path"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "websocket2layer4",
                  "type": "packet",
                  "connection_handler": "outline-shadowsocks"
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "account.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "file_server",
                  "root": "/srv/dobby/distribution"
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "outline.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "file_server",
                  "root": "/srv/www/outline"
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "outline": {
      "shadowsocks": {
        "replay_history": 10000
      },
      "connection_handlers": [
        {
          "name": "outline-shadowsocks",
          "handle": {
            "handler": "shadowsocks",
            "keys": [
              {
                "id": "primary",
                "cipher": "chacha20-ietf-poly1305",
                "secret": "replace-with-a-long-random-outline-secret"
              }
            ]
          }
        }
      ]
    }
  }
}
